# ============================================================
# CONCURSABOT — CONFIGURAÇÕES DE AMBIENTE (.env)
# ============================================================

# 1. Chave de API do Google Gemini (Obrigatória para IA, Tutor e RAG)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. Modelo Gemini Padrão (Opcional - Padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Códigos de Convite Autorizados (Separados por vírgula)
# Deixe em branco para permitir acesso livre (modo local)
# Ou configure códigos exclusivos para seus alunos/amigos:
INVITE_CODES=CONCURSA2026,MILITAR-VIP,RECEITA-PRO

# 4. Google OAuth 2.0 (Autenticação Oficial Google Accounts / Gmail)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 5. Ambiente e Porta (Configurados automaticamente pelo Render/Host)
NODE_ENV=production
PORT=3000
